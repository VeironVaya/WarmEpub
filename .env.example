# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=epub_user
POSTGRES_PASSWORD=epub_secret
POSTGRES_DB=epub_db

# ==========================================
# Backend Server Configuration
# ==========================================
PORT=8080
CORS_ORIGIN=http://localhost:5173

# ==========================================
# AI Translation & Definition Engine
# ==========================================
# Provider Options:
#   1. "gemini" - Uses Google Gemini API (Recommended: fast, accurate nuance)
#   2. "local"  - Uses local Ollama / OpenAI-compatible endpoint (100% offline & free)
AI_PROVIDER=gemini

# Google Gemini API Key (Optional)
# - Leave blank to run the reader in pure offline mode (reading, uploading, progress, dark mode all work!).
# - Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Models:
#   - "gemini-3.5-flash-lite" (Ultra-fast, lowest latency)
#   - "gemini-2.5-flash"      (High nuance, multi-lingual)
#   - "gemini-2.5-pro"        (Deep reasoning)
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# Local Offline Model Configuration (Ollama)
# ==========================================
# Used when AI_PROVIDER=local
# From Docker container, use host.docker.internal to access Ollama on your host machine.
LOCAL_MODEL_URL=http://host.docker.internal:11434/api/generate
LOCAL_MODEL_NAME=qwen2.5:1.5b
